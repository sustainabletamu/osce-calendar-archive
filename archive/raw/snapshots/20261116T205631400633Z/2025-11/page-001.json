0,3200\/16519_2025_01_AGF_Recycling_Bins_at_Allen_Building_final_report_2.rev.1761751511.jpg 2x, https:\/\/calendar.tamu.edu\/live\/image\/scale\/3x\/gid\/282\/width\/80\/height\/80\/crop\/1\/src_region\/0,0,2400,3200\/16519_2025_01_AGF_Recycling_Bins_at_Allen_Building_final_report_2.rev.1761751511.jpg 3x\" data-max-w=\"2400\" data-max-h=\"3200\" loading=\"lazy\" data-optimized=\"true\"\/>\n<\/picture>\n"},{"id":357096,"gid":282,"group_title":"Office of Sustainability","title":"Internship Application Closes","url":"https:\/\/calendar.tamu.edu\/sustainability\/event\/357096-internship-application-closes","date":"November 10<span class=\"lw_date_year\">, 2025<\/span>","date_time":"11:59pm","date_utc":"2025-11-11 05:59:00","date_iso":"2025-11-10T23:59:00-06:00","date_ts":1762840740,"tz_offset":-21600,"timezone":"America\/Chicago","date2_time":null,"date2_utc":null,"date2_iso":null,"date2_ts":null,"tz2_offset":null,"is_all_day":null,"repeats":null,"repeats_until":null,"repeats_start":"2025-11-11 05:59:00","repeats_end":null,"is_starred":null,"is_canceled":null,"is_online":null,"online_type":null,"online_url":null,"online_button_label":null,"online_instructions":null,"summary":"<p>\n  The Office of Sustainability &amp; Campus Enrichment\u2019s Undergraduate Internship Program applications close today. Learn more at sustainability.tamu.edu.&#160;\n<\/p>","description":"<p>\n  The goal of the Office of Sustainability &amp; Campus Enrichment\u2019s Internship Program is to bring undergraduate students from a variety of backgrounds and perspectives together to create a dynamic team that works to create a culture of sustainability at Texas A&amp;M University. Interns work together to increase awareness and education about the three pillars of sustainability: environmental, economic, and social. The team focuses on educating the campus community about topics such as: energy and water use, transportation, food services, construction and built environment, purchasing, recycling, and social sustainability through the development of outreach initiatives and event coordination. Additionally, interns support assessment and planning efforts prioritized by the office.\n<\/p>\n<p>\n  The Internship Program is open to any TAMU undergraduate student and all majors are encouraged to apply because true sustainability must be an interdisciplinary enterprise.<br \/>\n  <br \/>\n  Applications are open October 6, 2025 \u2013 November 9, 2025 at sustainability.tamu.edu.\n<\/p>","contact_info":"<p>\n  <strong>Office of Sustainability &amp; Campus Enrichment<br \/><\/strong>Texas A&amp;M University<br \/>\n  2245 TAMU | College Station, TX 77843-2245<br \/>\n  <br \/>\n  ph: 979.845.1911 | <a href=\"mailto:sustainability@tamu.edu\">sustainability@tamu.edu<\/a><br \/>\n  Follow us on IG\/FB\/Twitter:\u202f<a href=\"https:\/\/www.instagram.com\/sustainabletamu\/?hl=en\">@sustainableTAMU<\/a><br \/>\n  <a href=\"https:\/\/sustainability.tamu.edu\/\">https:\/\/sustainability.tamu.edu\/<\/a>\n<\/p>","cost":null,"status":1,"location":null,"location_title":null,"location_latitude":null,"location_longitude":null,"location_id":null,"thumbnail":"https:\/\/calendar.tamu.edu\/live\/image\/gid\/282\/width\/80\/height\/80\/crop\/1\/src_region\/0,0,720,540\/12235_logo-plus-maroon-graphic-stacked_720x540.png","thumbnail_caption":null,"thumbnail_alt":null,"has_registration":null,"registration_owner_email":"kwellman@tamu.edu","has_wait_list":null,"registration_limit":null,"wait_list_limit":null,"rsvp_total":null,"rsvp_waitlist_total":null,"event_types":null,"event_types_audience":["Students"],"event_types_campus":null,"tags":null,"tags_starred":null,"tags_global":null,"last_editor":"Caroline Gamble","last_modified":1761668944,"thumbnail:html":"<picture>\n\t<source type=\"image\/png\" srcset=\"https:\/\/calendar.tamu.edu\/live\/image\/scale\/2x\/gid\/282\/width\/80\/height\/80\/crop\/1\/src_region\/0,0,720,540\/12235_logo-plus-maroon-graphic-stacked_720x540.rev.1709054537.pn